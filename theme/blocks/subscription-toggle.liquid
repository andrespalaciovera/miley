{% doc %}
  Renders the Subscription Wrapper & Frequency Selector block.
  Implements SDD v1.2.0 Zone 2 and Section 9.2 CRO zero-friction subscription strategy.
  Emits 'theme:subscription:change' through <subscription-toggle> custom element.
{% enddoc %}

{{ 'component-subscription.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-subscription.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif

  assign sub_badge = block.settings.sub_discount_badge | default: 'products.subscription.subscribe_save' | t
  assign reassurance_text = block.settings.cancellation_reassurance | default: 'products.subscription.reassurance' | t
-%}

{%- if has_plans -%}
  <subscription-toggle
    class="subscription-toggle"
    data-product-id="{{ product.id }}"
    {{ block.shopify_attributes }}
  >
    <div class="subscription-toggle__segmented-control" role="tablist">
      <button
        type="button"
        class="subscription-tab subscription-tab--active"
        data-mode="onetime"
        role="tab"
        aria-selected="true"
      >
        {{ 'products.subscription.one_time' | t }}
      </button>

      <button
        type="button"
        class="subscription-tab"
        data-mode="subscribe"
        role="tab"
        aria-selected="false"
      >
        {{ sub_badge }}
      </button>
    </div>

    <div class="subscription-toggle__frequency-section" hidden>
      <div class="subscription-frequency__grid" role="group" aria-label="{{ 'products.subscription.every' | t }}">
        {%- assign first_group = product.selling_plan_groups.first -%}
        {%- for plan in first_group.selling_plans -%}
          <button
            type="button"
            class="frequency-tile{% if forloop.first %} frequency-tile--selected{% endif %}"
            data-plan-id="{{ plan.id }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="frequency-tile__prefix">{{ 'products.subscription.every' | t }}</span>
            <span class="frequency-tile__value">{{ plan.name }}</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="subscription-reassurance">
        <svg class="subscription-reassurance__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
        </svg>
        <span class="subscription-reassurance__text">{{ reassurance_text }}</span>
      </div>
    </div>
  </subscription-toggle>
{%- else -%}
  <subscription-toggle
    class="subscription-toggle"
    data-product-id="{{ product.id | default: 'demo' }}"
    {{ block.shopify_attributes }}
  >
    <div class="subscription-toggle__segmented-control" role="tablist">
      <button
        type="button"
        class="subscription-tab subscription-tab--active"
        data-mode="onetime"
        role="tab"
        aria-selected="true"
      >
        One-time purchase
      </button>

      <button
        type="button"
        class="subscription-tab"
        data-mode="subscribe"
        role="tab"
        aria-selected="false"
      >
        Subscribe & Save 15%
      </button>
    </div>

    <div class="subscription-toggle__frequency-section" hidden>
      <div class="subscription-frequency__grid" role="group" aria-label="Delivery frequency">
        <button
          type="button"
          class="frequency-tile frequency-tile--selected"
          aria-pressed="true"
        >
          <span class="frequency-tile__prefix">Every</span>
          <span class="frequency-tile__value">2 Weeks</span>
        </button>

        <button
          type="button"
          class="frequency-tile"
          aria-pressed="false"
        >
          <span class="frequency-tile__prefix">Every</span>
          <span class="frequency-tile__value">4 Weeks</span>
        </button>

        <button
          type="button"
          class="frequency-tile"
          aria-pressed="false"
        >
          <span class="frequency-tile__prefix">Every</span>
          <span class="frequency-tile__value">6 Weeks</span>
        </button>
      </div>

      <div class="subscription-reassurance">
        <svg class="subscription-reassurance__icon" viewBox="0 0 24 24" aria-hidden="true" width="14" height="14">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
        </svg>
        <span class="subscription-reassurance__text">Auto-renews, cancel anytime</span>
      </div>
    </div>
  </subscription-toggle>
{%- endif -%}

{% schema %}
{
  "name": "t:general.subscription_toggle",
  "settings": [
    {
      "type": "header",
      "content": "t:cro.headers.guardrail"
    },
    {
      "type": "text",
      "id": "sub_discount_badge",
      "label": "t:cro.labels.sub_discount_badge",
      "default": "Subscribe & Save 15%"
    },
    {
      "type": "text",
      "id": "cancellation_reassurance",
      "label": "t:cro.labels.cancellation_reassurance",
      "default": "Auto-renews, cancel anytime"
    }
  ]
}
{% endschema %}
