{% doc %}
  Renders the Origin & Sourcing Transparency Panel (Facts Panel) matching Figma Node 483:1847 & 491:954.
  Features background farm photography with gradient fade, Origin/Sourcing badge, Ethiopia silhouette map, and 4-sentence story.
{% enddoc %}

{{ 'component-telemetry.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign origin_data = product.metafields.custom.origin_telemetry.value
  assign origin_country = origin_data.country | default: 'Ethiopia'
  assign origin_story = product.metafields.custom.origin_story.value | default: origin_data.description
  if origin_story == blank
    assign origin_story = 'Grown at 1,950–2,100 masl on the Refisa washing station in the Guji Zone, Ethiopia. Sourced direct from a cooperative of 210 smallholder farmers. Fully washed and dried on raised beds for 12–15 days. This lot represents our 3rd year purchasing from this cooperative.'
  endif
-%}

<div class="origin-facts-panel" {{ block.shopify_attributes }}>
  <div class="origin-facts-panel__bg" aria-hidden="true">
    <img src="{{ 'origin-bg.png' | asset_url }}" alt="" class="origin-facts-panel__bg-img" width="358" height="302" loading="lazy">
    <div class="origin-facts-panel__bg-gradient"></div>
  </div>

  <div class="origin-facts-panel__content">
    <div class="origin-facts-panel__badge">
      <img src="{{ 'icon-reload.svg' | asset_url }}" alt="" width="16" height="16" aria-hidden="true">
      <span>Origin/Sourcing</span>
    </div>

    <div class="origin-facts-panel__header">
      <img src="{{ 'icon-ethiopia-map.svg' | asset_url }}" alt="" width="114" height="118" class="origin-facts-panel__map" aria-hidden="true">
      <h3 class="origin-facts-panel__title">{{ origin_country }}</h3>
    </div>

    <p class="origin-facts-panel__story">{{ origin_story }}</p>
  </div>
</div>

{% schema %}
{
  "name": "t:general.origin_telemetry",
  "settings": []
}
{% endschema %}
