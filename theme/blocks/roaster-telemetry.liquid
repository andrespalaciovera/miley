{% doc %}
  Renders the Product Profile & Sensory Telemetry block.
  Skin 1: 4 circular segmented gauges (Roast level, Acidity, Body, Sweetness).
  Skin 2: Functional benefit pills ('Supports Focus', 'No Jitters', 'Non-Habit Forming', 'Clean Energy').
{% enddoc %}

{{ 'component-telemetry.css' | asset_url | stylesheet_tag }}

{%- if settings.theme_skin == 'skin-2' -%}
  <div class="product-profile-pills" {{ block.shopify_attributes }}>
    <div class="product-pills-row">
      <span class="benefit-pill">Supports Focus</span>
      <span class="benefit-pill">No Jitters</span>
      <span class="benefit-pill">Non-Habit Forming</span>
    </div>
    <div class="product-pills-row">
      <span class="benefit-pill">Clean Energy</span>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign roast = product.metafields.custom.roast_level.value | default: 3
    assign acidity = 4
    assign body = 3
    assign sweetness = 4

    assign roast_label = 'products.telemetry.roast_level' | t
    assign acidity_label = 'products.telemetry.acidity' | t
    assign body_label = 'products.telemetry.body' | t
  -%}

  <div class="product-profile-gauges" {{ block.shopify_attributes }}>
    <div class="gauge-metric">
      {% render 'gauge-svg', level: roast, label: roast_label %}
      <span class="gauge-metric__label">{{ roast_label }}</span>
    </div>

    <div class="gauge-metric">
      {% render 'gauge-svg', level: acidity, label: acidity_label %}
      <span class="gauge-metric__label">{{ acidity_label }}</span>
    </div>

    <div class="gauge-metric">
      {% render 'gauge-svg', level: body, label: body_label %}
      <span class="gauge-metric__label">{{ body_label }}</span>
    </div>

    <div class="gauge-metric">
      {% render 'gauge-svg', level: sweetness, label: 'Sweetness' %}
      <span class="gauge-metric__label">Sweetness</span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.roaster_telemetry",
  "settings": []
}
{% endschema %}
