{% doc %}
  Renders the Complementary Products carousel/grid matching Figma Node 491:1023 & Product Card 491:1030 / 477:1015.
  Displays Contained Product Cards (borderless, edge-to-edge top media) with 4.5-star rating and 'Add for $9' button.
  Uses responsive image_tag srcset when Shopify complementary recommendations exist.
{% enddoc %}

{%- liquid
  assign rec_products = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
  assign has_recs = false
  if rec_products != blank
    assign has_recs = true
  endif
-%}

<div class="complementary-products-section" {{ block.shopify_attributes }}>
  <div class="complementary-header">
    <span class="complementary-title">{{ 'products.complementary.title' | t }}</span>
  </div>

  <div class="complementary-cards-scroll">
    {%- if has_recs -%}
      {%- for card_product in rec_products limit: 3 -%}
        {%- assign card_price = card_product.price | money_without_trailing_zeros -%}
        <div class="complementary-card">
          <div class="complementary-card__media">
            {%- if card_product.featured_media -%}
              {{
                card_product.featured_media
                | image_url: width: 480
                | image_tag:
                  widths: '180, 320, 480',
                  sizes: '(min-width: 1024px) 180px, (min-width: 768px) 220px, 162px',
                  class: 'complementary-card__img',
                  alt: card_product.title,
                  loading: 'lazy'
              }}
            {%- else -%}
              <img src="{{ 'pour-over-dripper.png' | asset_url }}" alt="{{ card_product.title | escape }}" class="complementary-card__img" width="162" height="161" loading="lazy">
            {%- endif -%}
          </div>

          <div class="complementary-card__info">
            <div class="complementary-card__stars" aria-label="4.8 out of 5 stars">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-half.svg' | asset_url }}" alt="" width="14" height="13">
            </div>
            <h4 class="complementary-card__title">{{ card_product.title }}</h4>
          </div>

          <button type="button" class="complementary-card__atc" data-quick-add data-variant-id="{{ card_product.selected_or_first_available_variant.id }}">
            {{ 'products.complementary.add_for' | t: price: card_price }}
          </button>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="complementary-card">
          <div class="complementary-card__media">
            {%- if settings.theme_skin == 'skin-2' -%}
              <img src="{{ 'vitality-focus-citrus-yellow.png' | asset_url }}" alt="Hydration Electrolytes" class="complementary-card__img" width="324" height="322" loading="lazy">
            {%- else -%}
              <img src="{{ 'pour-over-dripper.png' | asset_url }}" alt="Ceramic Pour-Over Dripper" class="complementary-card__img" width="324" height="322" loading="lazy">
            {%- endif -%}
          </div>

          <div class="complementary-card__info">
            <div class="complementary-card__stars" aria-label="4.8 out of 5 stars">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="14" height="13">
              <img src="{{ 'icon-star-half.svg' | asset_url }}" alt="" width="14" height="13">
            </div>
            <h4 class="complementary-card__title">
              {%- if settings.theme_skin == 'skin-2' -%}
                Daily Electrolytes Canister
              {%- else -%}
                Ceramic Pour-Over Dripper
              {%- endif -%}
            </h4>
          </div>

          <button type="button" class="complementary-card__atc" data-quick-add>
            {%- if settings.theme_skin == 'skin-2' -%}
              {{ 'products.complementary.add_for' | t: price: '$14' }}
            {%- else -%}
              {{ 'products.complementary.add_for' | t: price: '$9' }}
            {%- endif -%}
          </button>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Complementary Products",
  "settings": []
}
{% endschema %}
