{% doc %}
  Renders the Full Reviews Section matching Figma Nodes 491:1191, 484:2018, 491:1264, 491:1302, 489:2159, & 491:1394.
  Supports single-column mobile stack and 2-column desktop sticky summary + scrollable feed layout.
{% enddoc %}

<div class="reviews-section" {{ block.shopify_attributes }}>
  <div class="reviews-header">
    <h2 class="reviews-title">{{ 'products.reviews.title' | t }}</h2>
    <p class="reviews-subtitle">{{ 'products.reviews.subtitle' | t }}</p>
  </div>

  <div class="reviews-layout">
    <div class="reviews-sidebar">
      <div class="reviews-rating-summary-wrap">
        <div class="reviews-summary-card">
          <div class="reviews-verified-badge-row">
            <span class="reviews-verified-badge">
              <img src="{{ 'icon-reload.svg' | asset_url }}" alt="" width="16" height="16" aria-hidden="true">
              <span>{{ 'products.reviews.verified' | t }}</span>
            </span>
          </div>

          <div class="reviews-score-row">
            <span class="reviews-big-score">4.8</span>
            <div class="reviews-score-meta">
              <div class="reviews-summary-stars" aria-label="4.8 out of 5 stars">
                <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="15" height="14">
                <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="15" height="14">
                <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="15" height="14">
                <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="15" height="14">
                <img src="{{ 'icon-star-half.svg' | asset_url }}" alt="" width="15" height="14">
              </div>
              <span class="reviews-total-count">{{ 'products.reviews.based_on' | t: count: 128 }}</span>
            </div>
          </div>

          <div class="reviews-bars">
            <div class="review-bar-row">
              <span class="review-bar-label">5 ★</span>
              <div class="review-bar-track"><div class="review-bar-fill" style="width: 82%;"></div></div>
              <span class="review-bar-pct">82%</span>
            </div>
            <div class="review-bar-row">
              <span class="review-bar-label">4 ★</span>
              <div class="review-bar-track"><div class="review-bar-fill" style="width: 12%;"></div></div>
              <span class="review-bar-pct">12%</span>
            </div>
            <div class="review-bar-row">
              <span class="review-bar-label">3 ★</span>
              <div class="review-bar-track"><div class="review-bar-fill" style="width: 4%;"></div></div>
              <span class="review-bar-pct">4%</span>
            </div>
            <div class="review-bar-row">
              <span class="review-bar-label">2 ★</span>
              <div class="review-bar-track"><div class="review-bar-fill" style="width: 1%;"></div></div>
              <span class="review-bar-pct">1%</span>
            </div>
            <div class="review-bar-row">
              <span class="review-bar-label">1 ★</span>
              <div class="review-bar-track"><div class="review-bar-fill" style="width: 1%;"></div></div>
              <span class="review-bar-pct">1%</span>
            </div>
          </div>
        </div>

        <button type="button" class="reviews-write-btn">
          <img src="{{ 'icon-write-review.svg' | asset_url }}" alt="" width="16" height="17" aria-hidden="true">
          <span>{{ 'products.reviews.write_review' | t }}</span>
        </button>
      </div>

      <div class="reviews-media-strip">
        <div class="reviews-media-header">
          <div class="reviews-media-title-group">
            <span class="reviews-media-title">{{ 'products.reviews.customer_media' | t }}</span>
            <span class="reviews-media-count">18</span>
          </div>
          <button type="button" class="reviews-media-all-btn">
            <span>{{ 'products.reviews.view_all' | t }}</span>
            <svg width="5" height="8" viewBox="0 0 5 8" fill="none" aria-hidden="true">
              <path d="M1 1L4 4L1 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div class="reviews-media-thumbnails">
          <div class="review-thumb review-thumb--gradient">
            <img src="{{ 'ugc-thumb-1.png' | asset_url }}" alt="Customer photo 1" width="84" height="84" loading="lazy">
            <div class="review-thumb__scrim"></div>
          </div>

          <div class="review-thumb review-thumb--video">
            <img src="{{ 'ugc-thumb-2.png' | asset_url }}" alt="Customer video 2" width="84" height="84" loading="lazy">
            <div class="review-thumb__play-pill">
              <svg width="8" height="10" viewBox="0 0 8 10" fill="none" aria-hidden="true">
                <path d="M1 1L7 5L1 9V1Z" fill="currentColor"/>
              </svg>
            </div>
            <span class="review-thumb__duration">0:14</span>
          </div>

          <div class="review-thumb">
            <img src="{{ 'ugc-thumb-3.png' | asset_url }}" alt="Customer photo 3" width="84" height="84" loading="lazy">
          </div>

          <div class="review-thumb review-thumb--more">
            <span>+15</span>
            <span>More</span>
          </div>
        </div>
      </div>
    </div>

    <div class="reviews-main">
      <div class="reviews-controls-block">
        <div class="reviews-search-input-wrap">
          <img src="{{ 'icon-search.svg' | asset_url }}" alt="" width="14" height="14" class="reviews-search-icon" aria-hidden="true">
          <input
            type="search"
            class="reviews-search-input"
            placeholder="Search reviews, words, topics..."
            aria-label="Search reviews, words, topics"
          >
        </div>

        <div class="reviews-filter-chips">
          <button type="button" class="filter-chip filter-chip--active">
            <span>All</span>
            <span>(128)</span>
          </button>
          <button type="button" class="filter-chip">
            <img src="{{ 'icon-camera.svg' | asset_url }}" alt="" width="12" height="12" aria-hidden="true">
            <span>With photos</span>
            <span>(18)</span>
          </button>
          <button type="button" class="filter-chip">
            <span>Verified</span>
            <span>(114)</span>
          </button>
          <button type="button" class="filter-chip">
            <span>5 Stars</span>
            <span>(105)</span>
          </button>
        </div>

        <div class="reviews-matching-row">
          <span class="reviews-matching-text">128 reviews matching</span>
        </div>
      </div>

      <div class="reviews-cards-list">
        <article class="review-card">
          <div class="review-card__header">
            <div class="review-card__user">
              <div class="review-card__avatar">
                <span>SM</span>
              </div>
              <div class="review-card__user-info">
                <div class="review-card__name-row">
                  <span class="review-card__name">Sarah M.</span>
                  <img src="{{ 'icon-verified-badge.svg' | asset_url }}" alt="" width="14" height="13" aria-hidden="true">
                </div>
                <span class="review-card__verified-label">Verified purchase</span>
              </div>
            </div>
            <span class="review-card__date">Aug 18, 2026</span>
          </div>

          <div class="review-card__rating-variant">
            <div class="review-card__stars" aria-label="5 stars">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="13" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="13" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="13" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="13" height="13">
              <img src="{{ 'icon-star-filled.svg' | asset_url }}" alt="" width="13" height="13">
            </div>
            <div class="review-card__purchased-row">
              <img src="{{ 'icon-check-small.svg' | asset_url }}" alt="" width="10" height="10" aria-hidden="true">
              <span>
                {%- if settings.theme_skin == 'skin-2' -%}
                  Purchased: 2-Pack / 60 Capsules
                {%- else -%}
                  Purchased: 2-Pack / Matte Charcoal
                {%- endif -%}
              </span>
            </div>
          </div>

          <div class="review-card__content">
            <h4 class="review-card__title">
              {%- if settings.theme_skin == 'skin-2' -%}
                Zero brain fog by 10 AM, completely changed my workday
              {%- else -%}
                One of the best coffees I've tried
              {%- endif -%}
            </h4>

            <p class="review-card__body">
              {%- if settings.theme_skin == 'skin-2' -%}
                I was skeptical about nootropics, but Daily Focus Complex gives me a steady 6 hours of high cognitive focus without feeling wired. Clean ingredients and no upset stomach.
              {%- else -%}
                Really clean and bright without being too acidic. I’ve already ordered another bag. The aroma filling the kitchen every morning is worth it alone.
              {%- endif -%}
            </p>
          </div>

          <div class="review-card__media">
            <img src="{{ 'review-media-1.png' | asset_url }}" alt="Customer review attachment" width="60" height="60" class="review-card__media-img" loading="lazy">
          </div>

          <div class="review-card__footer">
            <button type="button" class="review-card__helpful-btn">
              <img src="{{ 'icon-helpful.svg' | asset_url }}" alt="" width="14" height="13" aria-hidden="true">
              <span>Helpful (14)</span>
            </button>

            <button type="button" class="review-card__report-btn">
              <img src="{{ 'icon-report.svg' | asset_url }}" alt="" width="9" height="10" aria-hidden="true">
              <span>Report</span>
            </button>
          </div>
        </article>
      </div>

      <div class="reviews-view-more-wrap">
        <button type="button" class="reviews-view-more-btn">
          <span>View More</span>
          <img src="{{ 'icon-chevron.svg' | asset_url }}" alt="" width="12" height="12" aria-hidden="true">
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews Section",
  "settings": []
}
{% endschema %}
