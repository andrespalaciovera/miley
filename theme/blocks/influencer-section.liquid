{% doc %}
  Renders the Influencer / UGC Video Section matching Figma Node 483:1945 & 491:1177.
  Displays Card 1 (201x358px with top-right mute & pause icons) and Card 2 (185x330px with centered 40x40 play icon).
{% enddoc %}

<div class="influencer-section" {{ block.shopify_attributes }}>
  <div class="influencer-header">
    <h2 class="influencer-title">What others say about us</h2>
  </div>

  <div class="influencer-video-track">
    <div class="influencer-video-card influencer-video-card--primary">
      <img src="{{ 'influencer-1.png' | asset_url }}" alt="Customer tasting Solstice Guji coffee" class="influencer-video-poster" width="201" height="358" loading="lazy">
      <button type="button" class="influencer-icon-btn influencer-icon-btn--mute" aria-label="Mute video">
        <img src="{{ 'icon-mute.svg' | asset_url }}" alt="" width="16" height="16" aria-hidden="true">
      </button>
      <button type="button" class="influencer-icon-btn influencer-icon-btn--pause" aria-label="Pause video">
        <img src="{{ 'icon-pause.svg' | asset_url }}" alt="" width="16" height="16" aria-hidden="true">
      </button>
    </div>

    <div class="influencer-video-card influencer-video-card--secondary">
      <img src="{{ 'influencer-2.png' | asset_url }}" alt="Barista pour-over demonstration" class="influencer-video-poster" width="185" height="330" loading="lazy">
      <button type="button" class="influencer-icon-btn influencer-icon-btn--play" aria-label="Play video">
        <img src="{{ 'icon-play.svg' | asset_url }}" alt="" width="40" height="40" aria-hidden="true">
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Influencer Section",
  "settings": []
}
{% endschema %}
