{% doc %}
  Renders the Influencer / UGC Video Section matching Figma Node 483:1945.
  Displays customer UGC story videos with play/pause controls.
{% enddoc %}

<div class="influencer-section" {{ block.shopify_attributes }}>
  <div class="influencer-header">
    <h2 class="influencer-title">What others say about us</h2>
  </div>

  <div class="influencer-video-track">
    <div class="influencer-video-card">
      <img src="{{ 'influencer-1.png' | asset_url }}" alt="Customer tasting Solstice Guji coffee" class="influencer-video-poster" width="201" height="358" loading="lazy">
      <div class="influencer-video-overlay">
        <div class="influencer-btn-top">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="Mute">
            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09l2.09 2.09V4z"/>
          </svg>
        </div>
        <div class="influencer-btn-play">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="white" aria-label="Play video">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <span class="influencer-tag">@coffeewithsarah</span>
      </div>
    </div>

    <div class="influencer-video-card">
      <img src="{{ 'influencer-2.png' | asset_url }}" alt="Barista pour-over demonstration" class="influencer-video-poster" width="201" height="358" loading="lazy">
      <div class="influencer-video-overlay">
        <div class="influencer-btn-top">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="Mute">
            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09l2.09 2.09V4z"/>
          </svg>
        </div>
        <div class="influencer-btn-play">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="white" aria-label="Play video">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <span class="influencer-tag">@dailyroutine_dev</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Influencer Section",
  "settings": []
}
{% endschema %}
