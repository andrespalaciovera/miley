{% doc %}
  Renders the Sticky Add-to-Cart bar matching Figma Node 489:2232 / 587:2103 / 491:1399.
  Features a 132px bottom bar with an 80x80 protruding product thumbnail (top: -37px),
  variant summary + Edit trigger on row 1, and TOTAL/$20 + Add to Cart primary button on row 2.
{% enddoc %}

{{ 'component-sticky-atc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-sticky-atc.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_price = '$20'
  if settings.theme_skin == 'skin-2'
    assign display_price = '$29'
  endif

  assign fallback_thumb = 'solstice-coffee-bag.png'
  if settings.theme_skin == 'skin-2'
    assign fallback_thumb = 'vitality-daily-focus.png'
  endif
-%}

<sticky-add-to-cart
  class="sticky-atc--visible"
  data-product-id="{{ product.id | default: 'demo' }}"
  data-initial-variant-id="{{ current_variant.id | default: 'demo' }}"
  data-initial-price="{{ current_variant.price | default: 2000 }}"
  {{ block.shopify_attributes }}
>
  <div class="sticky-atc__inner">
    <div class="sticky-atc__media">
      <img
        src="{{ fallback_thumb | asset_url }}"
        alt="Product thumbnail"
        width="80"
        height="80"
        loading="lazy"
        data-sticky-image
      >
    </div>

    <div class="sticky-atc__top-row">
      <span class="sticky-atc__selection" data-sticky-title>2 Packs - Every month</span>
      <button type="button" class="sticky-atc__edit-btn" onclick="window.scrollTo({top: 480, behavior: 'smooth'})">
        <img src="{{ 'icon-pencil.svg' | asset_url }}" alt="" width="12" height="12" aria-hidden="true">
        <span>Edit</span>
      </button>
    </div>

    <div class="sticky-atc__bottom-row">
      <div class="sticky-atc__price-box">
        <span class="sticky-atc__price-label">TOTAL</span>
        <span class="sticky-atc__price-value" data-sticky-price>{{ display_price }}</span>
      </div>

      <button
        type="button"
        class="sticky-atc__btn"
        data-sticky-atc-btn
        data-cart-trigger
        data-label-atc="Add to Cart"
        data-label-sold-out="{{ 'products.sold_out' | t }}"
      >
        <img src="{{ 'icon-atc-bag.svg' | asset_url }}" alt="" width="14" height="16" aria-hidden="true">
        <span>Add to Cart</span>
      </button>
    </div>
  </div>
</sticky-add-to-cart>

{% schema %}
{
  "name": "t:general.sticky_add_to_cart",
  "settings": []
}
{% endschema %}
