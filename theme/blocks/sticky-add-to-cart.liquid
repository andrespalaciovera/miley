{% doc %}
  Renders the Sticky Add-to-Cart bar.
  Implements SDD v1.2.0 Zone 2 mobile persistent conversion bar.
  Slides into view when primary CTA scrolls past the viewport.
{% enddoc %}

{{ 'component-sticky-atc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-sticky-atc.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_price = current_variant.price | money
  if display_price == '$0.00' or display_price == blank
    if settings.theme_skin == 'skin-2'
      assign display_price = '$29.00'
    else
      assign display_price = '$20.00'
    endif
  endif

  assign fallback_thumb = 'solstice-coffee-bag.png'
  if settings.theme_skin == 'skin-2'
    assign fallback_thumb = 'vitality-daily-focus.png'
  endif
-%}

<sticky-add-to-cart
  data-product-id="{{ product.id | default: 'demo' }}"
  data-initial-variant-id="{{ current_variant.id | default: 'demo' }}"
  data-initial-price="{{ current_variant.price | default: 2000 }}"
  {{ block.shopify_attributes }}
>
  <div class="sticky-atc__inner">
    <div class="sticky-atc__media">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 96 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="48"
          height="48"
          loading="lazy"
          data-sticky-image
        >
      {%- else -%}
        <img
          src="{{ fallback_thumb | asset_url }}"
          alt="Product thumbnail"
          width="48"
          height="48"
          loading="lazy"
          data-sticky-image
        >
      {%- endif -%}
    </div>

    <div class="sticky-atc__info">
      <div class="sticky-atc__title-row">
        <span class="sticky-atc__title" data-sticky-title>
          {%- if settings.theme_skin == 'skin-2' -%}
            Daily Focus Complex
          {%- else -%}
            Ethiopia Guji (1 Bag)
          {%- endif -%}
        </span>
      </div>
    </div>

    <div class="sticky-atc__action-group">
      <div class="sticky-atc__price-box">
        <span class="sticky-atc__price-value" data-sticky-price>{{ display_price }}</span>
      </div>

      <button
        type="button"
        class="sticky-atc__btn"
        data-sticky-atc-btn
        data-label-atc="{{ 'products.add_to_cart' | t }}"
        data-label-sold-out="{{ 'products.sold_out' | t }}"
      >
        {{ 'products.add_to_cart' | t }}
      </button>
    </div>
  </div>
</sticky-add-to-cart>

{% schema %}
{
  "name": "t:general.sticky_add_to_cart",
  "settings": []
}
{% endschema %}
