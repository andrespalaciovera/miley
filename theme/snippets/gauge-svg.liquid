{% doc %}
  Renders the 5-segment circular gauge graphic matching Figma Node 481:1810.
  @param {number} [level] - Sensory intensity level (1-5).
{% enddoc %}

<div class="gauge-metric__circle" data-level="{{ level | default: 3 }}">
  <img src="{{ 'icon-gauge-arc.svg' | asset_url }}" alt="" width="56" height="56" class="gauge-metric__svg" aria-hidden="true">
</div>
