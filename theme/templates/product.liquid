{% block 'container' %}
  {% render 'product-data-island', product: product %}

  <div class="product-layout">
    <div class="product-visual-column">
      {% block 'product-gallery' %}{% endblock %}
    </div>

    <div class="product-details-column">
      {% block 'product-meta' %}{% endblock %}

      {% block 'roaster-telemetry' %}{% endblock %}

      {% block 'trust-icons' %}{% endblock %}

      {% block 'product-description' %}{% endblock %}

      <div class="purchase-decision-zone">
        {% block 'pack-selector' %}{% endblock %}

        {% block 'subscription-toggle' %}{% endblock %}

        <product-form-controller class="product-form">
          {% form 'product', product, id: 'MainProductForm' %}
            {% assign current_variant = product.selected_or_first_available_variant %}

            <input type="hidden" name="id" value="{{ current_variant.id | default: 1 }}">
            <input type="hidden" name="selling_plan" value="">
            <input type="hidden" name="quantity" min="1" value="1">

            <button
              type="submit"
              name="add"
              class="product-form__submit btn-primary"
              data-primary-atc
              data-label-atc="{{ 'products.add_to_cart' | t }}"
              data-label-sold-out="{{ 'products.sold_out' | t }}"
            >
              {{ 'products.add_to_cart' | t }}
            </button>
            {{ form | payment_button }}
          {% endform %}
        </product-form-controller>
      </div>

      <div class="transparency-zone">
        {% block 'facts-table' %}{% endblock %}

        {% block 'origin-telemetry' %}{% endblock %}

        {% block 'brewing-recipe-tabs' %}{% endblock %}
      </div>

      <div class="trust-continuation-zone">
        {% block 'shipping-info' %}{% endblock %}

        {% block 'faq-accordion' %}{% endblock %}

        {% block 'complementary-products' %}{% endblock %}
      </div>
    </div>
  </div>

  <div class="pdp-social-proof">
    {% block 'testimonials' %}{% endblock %}

    {% block 'influencer-section' %}{% endblock %}

    {% block 'reviews-section' %}{% endblock %}
  </div>

  {% block 'sticky-add-to-cart' %}{% endblock %}
{% endblock %}

<script src="{{ 'component-product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'anim-scrubber.js' | asset_url }}" defer="defer"></script>
