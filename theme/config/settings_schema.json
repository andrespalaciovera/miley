[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:skins.title",
    "settings": [
      {
        "type": "header",
        "content": "t:skins.header"
      },
      {
        "type": "paragraph",
        "content": "t:skins.paragraph"
      },
      {
        "type": "select",
        "id": "theme_skin",
        "label": "t:skins.label",
        "default": "skin-1",
        "options": [
          {
            "value": "skin-1",
            "label": "t:skins.options.skin_1"
          },
          {
            "value": "skin-2",
            "label": "t:skins.options.skin_2"
          }
        ]
      }
    ]
  },
  {
    "name": "t:cro.title",
    "settings": [
      {
        "type": "header",
        "content": "t:cro.headers.cart_gamification"
      },
      {
        "type": "paragraph",
        "content": "t:cro.paragraphs.cart_gamification"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 25,
        "max": 120,
        "step": 5,
        "unit": "$",
        "label": "t:cro.labels.free_shipping_threshold",
        "default": 35
      },
      {
        "type": "range",
        "id": "free_gift_threshold",
        "min": 40,
        "max": 200,
        "step": 5,
        "unit": "$",
        "label": "t:cro.labels.free_gift_threshold",
        "default": 60
      },
      {
        "type": "text",
        "id": "free_gift_name",
        "label": "t:cro.labels.free_gift_name",
        "default": "Free Sample Bag Included"
      }
    ]
  }
]
